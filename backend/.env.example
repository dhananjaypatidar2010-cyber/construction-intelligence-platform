# Choose one provider: anthropic | gemini | mock
# "mock" needs no API key and returns realistic sample data so the whole app runs offline.
LLM_PROVIDER=mock

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

CORS_ORIGINS=http://localhost:5173
MAX_IMAGE_MB=8
